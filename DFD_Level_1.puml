' System decomposition: published Level 1 API.
!include DFD.puml
!ifndef DFD_LEVEL_1_LOADED
!define DFD_LEVEL_1_LOADED
!global $DFD_LEVEL = 1
!global $LEVEL = "DFD Level 1"
!unquoted procedure Process($label)
  !if $DFD_CLUSTER_OPEN
    !assert %false() : "Close the preceding boundary first"
  !endif
  !global $DFD_CLUSTER_OPEN = 1
  !$text = DFD_Text($label)
subgraph cluster_level1 {
graph [clusterrank=local rankdir=TB labeljust=c labelloc=t color=grey label="$text"]
!endprocedure
!procedure DataFlows()
  !if ($DFD_CLUSTER_OPEN == 0)
    !assert %false() : "Boundary close requires an open Level 1 process"
  !endif
  !global $DFD_CLUSTER_OPEN = 0
}
!endprocedure
!unquoted procedure SubProcess($alias, $id, $label)
DFD_Component($alias, $label, $id, "process")
!endprocedure
!unquoted procedure DataStore($alias, $label, $id="D")
DFD_Component($alias, $label, $id, "datastore")
!endprocedure
!endif
